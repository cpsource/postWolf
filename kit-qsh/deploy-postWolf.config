# /etc/postWolf/config — minimal config for the qsh deployment kit.
#
# Installed by `make install` (target: install-config).  Augeas /
# Myconf lens compatible; whitespace-separated `key value` pairs
# grouped under [section] headers.
#
# Edit url-server if the MTC log server for your identity is not
# factsorlie.com.

[global]
url-server  https://factsorlie.com:8446

[qsh]
qshd-port   1024
