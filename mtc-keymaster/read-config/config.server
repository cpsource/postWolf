
[global]

url-bootstrap https://factsorlie.com:8445

url-server https://factsorlie.com:8446

url-local https://factsorlie.com:8444

# --- MQC operational tunables --------------------------------------
# Each key is optional.  Omitting a key uses the compiled-in default
# (shown in the comment).  Spec normative reference: §11 of
# socket-level-wrapper-MQC/draft-page-mqc-protocol-00.md.  Per-issue
# design discussion: socket-level-wrapper-MQC/mqc-issue-{6a,7,8,12}.plan.

# Handshake timeouts (seconds).  Bump for very slow links.
# mqc-handshake-stall-sec       3
# mqc-handshake-total-sec       5

# Frame-size ceilings (bytes).  Spec §11.3: implementations MAY lower
# these but MUST NOT raise them; values above the compiled cap are
# silently clamped.
# mqc-max-handshake-bytes       131072
# mqc-max-msg-bytes             1048576

# Per-IP rate limits (Redis-backed).  Tune to deployment threat model.
# mqc-rl-connect-per-min        100
# mqc-rl-connect-per-hour       1000
# mqc-rl-fail-per-min           10
# mqc-rl-fail-per-hour          100

# Per-IP distinct-cert_index throttle (issue #12).  Caps how many
# distinct cert_index values a single source IP can present per
# minute / per hour.  Defends against an attacker rotating
# cert_index every connect to force fresh cert fetches +
# cosignature verifies (each ~ms of asymmetric work).
# mqc-rl-cert-per-min           10
# mqc-rl-cert-per-hour          100

# Server-side fork backpressure.  Caps how many concurrent
# per-connection child processes the listeners (TLS/plain on 8444,
# MQC on 8446) will keep alive.  Before each accept(), the listener
# checks the active-child counter; if it's >= this value, sleeps 1s
# and re-checks.  Defends against fork-storm OOM under bursty load
# (e.g., a CI stress run that opens dozens of parallel handshakes).
# Children continue running once spawned; only the *accept rate* is
# throttled, so bursts stretch out instead of fanning into hundreds
# of concurrent forks.  Compiled-in default
# (MTC_MAX_CHILDREN_DEFAULT in mtc_http.h):
# mqc-max-children              20

# Cache + skew windows (seconds).
# mqc-revoked-cache-ttl-sec     86400
# mqc-sig-freshness-sec         300

# Revocation enforcement policy (issue #7).  Default: mandatory.
#   mandatory   = both peers query log on cache miss; abort handshake
#                 on query failure (fail-closed).
#   cache-only  = use cache only; abort on cache miss; never touches
#                 the network.  Use during planned log-endpoint
#                 maintenance windows.
#   disabled    = skip revocation entirely.  UNSAFE; emergency
#                 recovery only.  A loud REVOCATION_DISABLED warning
#                 is logged at process start when this is selected.
# mqc-revocation-policy        mandatory
