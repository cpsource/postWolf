# Makefile.tools — top-level build for postWolf tools
#
# Builds the socket-level wrappers (SLC, MQC), MTC keymaster tools
# (server, show-tpm, bootstrap_ca, bootstrap_leaf), and the FIPS-manifest
# tools (fips-manifest-{submit,verify,list}).
#
# The postWolf library itself is built separately via autotools:
#   ./configure.sh && make -f Makefile && sudo make -f Makefile install && sudo ldconfig
#
# Usage:
#   make -f Makefile.tools               Build SLC, MQC, and all MTC tools
#   sudo make -f Makefile.tools install  Install tools to /usr/local/bin and run ldconfig
#   make -f Makefile.tools clean         Clean all build artifacts
#
# DEPRECATED 2026-05-06: socket-level-wrapper-QUIC (MQCP) is no longer
# built or maintained.  See socket-level-wrapper-QUIC/README.md.  The
# `quic` target stays as a no-op so any external scripts that ran
# `make -f Makefile.tools quic` don't break.

SLC_DIR = socket-level-wrapper
MQC_DIR = socket-level-wrapper-MQC
MTC_DIR   = mtc-keymaster/server2/c
TOOLS_DIR = mtc-keymaster/tools/c
TESTS_DIR = mtc-keymaster/tests/c
FIPS_DIR  = fips-framework/tools/c
QSH_CLIENT_DIR = qsh/qsh
QSHD_DIR       = qsh/qshd

.PHONY: all install clean slc mqc quic mtc tools tests fips qsh install-lib kit

all: slc mqc mtc tools tests fips qsh

# Socket-level wrapper (TLS)
slc:
	$(MAKE) -C $(SLC_DIR)

# Socket-level wrapper (MQC / post-quantum)
mqc:
	$(MAKE) -C $(MQC_DIR)

# DEPRECATED — no-op kept for backwards compatibility with external
# scripts.  See socket-level-wrapper-QUIC/README.md.
quic:
	@echo "socket-level-wrapper-QUIC is deprecated (2026-05-06); skipping."

# MTC keymaster server (mtc_server) — depends on slc + mqc libraries
mtc: slc mqc
	$(MAKE) -C $(MTC_DIR)

# MTC keymaster client tools (show-tpm, bootstrap_ca, bootstrap_leaf,
# admin_recosign, issue_leaf_nonce) — depends on mqc + shared helpers
# in $(MTC_DIR)
tools: mqc mtc
	$(MAKE) -C $(TOOLS_DIR)

# End-to-end test drivers (test_revoke_matrix, etc.) — same deps as
# tools.  Build-only target: binaries stay in-tree under $(TESTS_DIR)
# and are invoked by the wrappers in mtc-keymaster/tests/ via relative
# path, so there's no `install` step.
tests: mqc mtc
	$(MAKE) -C $(TESTS_DIR)

# FIPS-manifest tools (fips-manifest-{submit,verify,list}) — self-contained;
# links the installed libpostWolf via pkg-config the same way the MTC tools
# do, so the library must already be installed.
fips:
	$(MAKE) -C $(FIPS_DIR)

# MQC shell client + daemon (qsh, qshd) — links the in-tree libmqc.a
# plus the installed libpostWolf, like the FIPS tools.
qsh: mqc
	$(MAKE) -C $(QSH_CLIENT_DIR)
	$(MAKE) -C $(QSHD_DIR)

# Install postWolf library (autotools) + ldconfig
install-lib:
	$(MAKE) -f Makefile install
	ldconfig

# Install tools to /usr/local/bin + refresh ldconfig.
# mtc-ca.service and the mtc_server binary are each updated only if their
# repo copy differs from the installed one (cmp -s).  If anything changed
# AND the service is currently active, restart it once at the end so the
# new unit (daemon-reload'd) and the new binary land together.
install: all
	ldconfig
	@_RESTART=0; \
	if cmp -s mtc-keymaster/read-config/myconf.aug \
	         $(DESTDIR)/usr/local/share/augeas/lenses/myconf.aug 2>/dev/null; then \
		echo "[install] myconf.aug unchanged"; \
	else \
		echo "[install] installing fresh myconf.aug"; \
		install -d $(DESTDIR)/usr/local/share/augeas/lenses; \
		install -m 644 mtc-keymaster/read-config/myconf.aug \
			$(DESTDIR)/usr/local/share/augeas/lenses/myconf.aug; \
		_RESTART=1; \
	fi; \
	if cmp -s mtc-keymaster/read-config/config.server \
	         $(DESTDIR)/etc/postWolf/config 2>/dev/null; then \
		echo "[install] /etc/postWolf/config unchanged"; \
	else \
		echo "[install] installing fresh /etc/postWolf/config"; \
		install -d $(DESTDIR)/etc/postWolf; \
		install -m 644 mtc-keymaster/read-config/config.server \
			$(DESTDIR)/etc/postWolf/config; \
		_RESTART=1; \
	fi; \
	if cmp -s mtc-keymaster/server2/c/mtc-ca.service \
	         $(DESTDIR)/etc/systemd/system/mtc-ca.service 2>/dev/null; then \
		echo "[install] mtc-ca.service unchanged"; \
	else \
		echo "[install] installing fresh mtc-ca.service"; \
		install -d $(DESTDIR)/etc/systemd/system; \
		install -m 644 mtc-keymaster/server2/c/mtc-ca.service \
			$(DESTDIR)/etc/systemd/system/mtc-ca.service; \
		[ -z "$(DESTDIR)" ] && systemctl daemon-reload; \
		_RESTART=1; \
	fi; \
	if cmp -s mtc-keymaster/server2/c/mtc_server \
	         $(DESTDIR)/usr/local/bin/mtc_server 2>/dev/null; then \
		echo "[install] mtc_server unchanged"; \
	else \
		echo "[install] installing fresh mtc_server"; \
		install -d $(DESTDIR)/usr/local/bin; \
		install -m 755 mtc-keymaster/server2/c/mtc_server \
			$(DESTDIR)/usr/local/bin/mtc_server; \
		_RESTART=1; \
	fi; \
	if [ "$$_RESTART" = "1" ] && [ -z "$(DESTDIR)" ] && \
	   systemctl is-active --quiet mtc-ca.service 2>/dev/null; then \
		echo "[install] restarting mtc-ca.service"; \
		systemctl restart mtc-ca.service; \
	fi
	$(MAKE) -C $(TOOLS_DIR) install
	install -d $(DESTDIR)/usr/local/sbin
	install -m 755 mtc-keymaster/tools/sh/setup-recert-crond.sh \
		$(DESTDIR)/usr/local/sbin/setup-recert-crond.sh
	install -m 755 mtc-keymaster/tools/sh/register-ca.sh \
		$(DESTDIR)/usr/local/bin/register-ca.sh
	install -m 755 mtc-keymaster/tools/sh/register-leaf.sh \
		$(DESTDIR)/usr/local/bin/register-leaf.sh
	install -m 755 mtc-keymaster/tools/python/create_ca_cert.py \
		$(DESTDIR)/usr/local/bin/create_ca_cert.py
	install -m 755 mtc-keymaster/tools/python/create_leaf_keypair.py \
		$(DESTDIR)/usr/local/bin/create_leaf_keypair.py
	install -m 755 mtc-keymaster/tools/python/ca_dns_txt.py \
		$(DESTDIR)/usr/local/bin/ca_dns_txt.py
	install -m 755 mtc-keymaster/tools/python/create_server_cert.py \
		$(DESTDIR)/usr/local/bin/create_server_cert.py
	install -m 755 mtc-keymaster/tools/python/verify.py \
		$(DESTDIR)/usr/local/bin/verify.py
	install -m 755 mtc-keymaster/tools/python/verify_certificate.py \
		$(DESTDIR)/usr/local/bin/verify_certificate.py
	$(MAKE) -C $(FIPS_DIR) install
	install -m 755 fips-framework/tools/sh/sign-dir.sh \
		$(DESTDIR)/usr/local/bin/sign-dir.sh
	install -m 755 fips-framework/tools/sh/verify-dir.sh \
		$(DESTDIR)/usr/local/bin/verify-dir.sh
	@_QSHD_RESTART=0; \
	install -d $(DESTDIR)/usr/local/bin; \
	if cmp -s $(QSH_CLIENT_DIR)/qsh \
	         $(DESTDIR)/usr/local/bin/qsh 2>/dev/null; then \
		echo "[install] qsh unchanged"; \
	else \
		echo "[install] installing fresh qsh"; \
		install -m 755 $(QSH_CLIENT_DIR)/qsh \
			$(DESTDIR)/usr/local/bin/qsh; \
	fi; \
	if cmp -s $(QSHD_DIR)/qshd \
	         $(DESTDIR)/usr/local/bin/qshd 2>/dev/null; then \
		echo "[install] qshd unchanged"; \
	else \
		echo "[install] installing fresh qshd"; \
		install -m 755 $(QSHD_DIR)/qshd \
			$(DESTDIR)/usr/local/bin/qshd; \
		_QSHD_RESTART=1; \
	fi; \
	if cmp -s $(QSHD_DIR)/qshd.service \
	         $(DESTDIR)/etc/systemd/system/qshd.service 2>/dev/null; then \
		echo "[install] qshd.service unchanged"; \
	else \
		echo "[install] installing fresh qshd.service"; \
		install -d $(DESTDIR)/etc/systemd/system; \
		install -m 644 $(QSHD_DIR)/qshd.service \
			$(DESTDIR)/etc/systemd/system/qshd.service; \
		[ -z "$(DESTDIR)" ] && systemctl daemon-reload; \
		_QSHD_RESTART=1; \
	fi; \
	if [ -f $(DESTDIR)/etc/qsh/qshd/config ]; then \
		echo "[install] /etc/qsh/qshd/config preserved (operator-edited)"; \
	else \
		echo "[install] installing default /etc/qsh/qshd/config (denies all)"; \
		install -d $(DESTDIR)/etc/qsh/qshd; \
		install -m 644 $(QSHD_DIR)/qshd-config-template \
			$(DESTDIR)/etc/qsh/qshd/config; \
	fi; \
	if [ "$$_QSHD_RESTART" = "1" ] && [ -z "$(DESTDIR)" ] && \
	   systemctl is-active --quiet qshd.service 2>/dev/null; then \
		echo "[install] restarting qshd.service"; \
		systemctl restart qshd.service; \
	fi
	@_INVOKING_USER=$${SUDO_USER:-$$(id -un)}; \
	_INVOKING_HOME=$$(getent passwd $$_INVOKING_USER | cut -d: -f6); \
	if [ -d "$$_INVOKING_HOME/.TPM/factsorlie.com" ]; then \
		echo "[install] rebuilding kit-qsh (bundles /usr/local/bin/qsh)"; \
		if [ -n "$$SUDO_USER" ]; then \
			sudo -u $$SUDO_USER $(MAKE) -C kit-qsh; \
		else \
			$(MAKE) -C kit-qsh; \
		fi; \
		echo "[install] kit-qsh/deploy-qsh.tar.gz refreshed"; \
	else \
		echo "[install] kit-qsh skipped (no factsorlie.com identity at $$_INVOKING_HOME/.TPM)"; \
	fi

# Standalone: rebuild the kit tarball without reinstalling everything.
# Pulls /usr/local/bin/qsh, so make sure `install` has been run since
# the last qsh change.  The kit Makefile reads $HOME/.TPM/... so this
# target is normally run un-sudoed (the `install` chain de-sudos
# automatically via SUDO_USER).
kit:
	@$(MAKE) -C kit-qsh

clean:
	$(MAKE) -C $(SLC_DIR) clean
	$(MAKE) -C $(MQC_DIR) clean
	$(MAKE) -C $(MTC_DIR) clean
	$(MAKE) -C $(TOOLS_DIR) clean
	$(MAKE) -C $(TESTS_DIR) clean
	$(MAKE) -C $(FIPS_DIR) clean
	$(MAKE) -C $(QSH_CLIENT_DIR) clean
	$(MAKE) -C $(QSHD_DIR) clean

# -- Phase 4 system-level tests --------------------------------------
# Aggregate regression suite (P4a).  Builds dependent test binaries
# under socket-level-wrapper-MQC/tests, then drives the whole MQC
# suite-of-suites via mtc-keymaster/tools/sh/test-mqc-all.sh against
# a live mtc-ca.service.  Knobs: TARGET_HOST, TARGET_PORT, DOMAIN.
test-mqc-all: tools
	$(MAKE) -C $(MQC_DIR) tests/test_name_check
	@./mtc-keymaster/tools/sh/test-mqc-all.sh

# Attack-simulation pack only (P4f).  Subset of test-mqc-all for
# fast iteration on attack regressions.
test-attack-pack: tools
	$(MAKE) -C $(MQC_DIR) tests/test_name_check
	@SKIP_NAME_CHECK=0 SKIP_ATTACK_PACK=0 \
	    QUIET=1 ./mtc-keymaster/tools/sh/test-mqc-all.sh

# Cross-tool matrix (P4b).  Cycles mqc-revocation-policy through
# {mandatory, cache-only, disabled} and runs each MQC client tool
# under each policy.  Saves + restores /etc/postWolf/config and
# restarts mtc-ca.service between cells, so requires sudo without
# prompt.  Runtime ~30s.
test-mqc-matrix: tools
	@./mtc-keymaster/tools/sh/test-mqc-matrix.sh

# Concurrent-handshake stress (P4c).  Spawns N parallel encode|decode
# roundtrips and asserts the server stays up + fd counts return to
# baseline.  Knobs: STRESS_N (default 30), STRESS_REPEAT (default 1).
test-mqc-stress: tools
	@./mtc-keymaster/tools/sh/test-mqc-stress.sh

# Cosigner-rotation drill (P4d).  Corrupts the local cosigner-fp.hex
# cache for a peer, runs show-tpm --verify, and asserts the issue-#8
# invariant detected the mismatch + restored the cache.
test-cosigner-rotation: tools
	@./mtc-keymaster/tools/sh/test-cosigner-rotation.sh

# Performance baseline snapshot (P4g).  Runs show-tpm --verify N
# times sequentially and captures min / mean / median / p95 / p99 /
# max wall-clock latency to mtc-keymaster/perf/perf-snapshot-<date>.txt.
# Knob: PERF_N (default 10).
test-mqc-perf: tools
	@./mtc-keymaster/tools/sh/test-mqc-perf.sh

.PHONY: test-mqc-all test-attack-pack test-mqc-matrix test-mqc-stress \
        test-cosigner-rotation test-mqc-perf
