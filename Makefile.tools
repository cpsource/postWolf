# Makefile.tools — top-level build for postWolf tools
#
# Builds the socket-level wrappers (SLC, MQC, QUIC) and MTC keymaster
# tools (server, show-tpm, bootstrap_ca, bootstrap_leaf).
#
# The postWolf library itself is built separately via autotools:
#   ./configure.sh && make -f Makefile && sudo make -f Makefile install && sudo ldconfig
#
# Usage:
#   make -f Makefile.tools               Build SLC, MQC, QUIC, and all MTC tools
#   sudo make -f Makefile.tools install  Install tools to /usr/local/bin and run ldconfig
#   make -f Makefile.tools clean         Clean all build artifacts

SLC_DIR = socket-level-wrapper
MQC_DIR = socket-level-wrapper-MQC
QUIC_DIR = socket-level-wrapper-QUIC
MTC_DIR   = mtc-keymaster/server2/c
TOOLS_DIR = mtc-keymaster/tools/c

.PHONY: all install clean slc mqc quic mtc tools install-lib

all: slc mqc quic mtc tools

# Socket-level wrapper (TLS)
slc:
	$(MAKE) -C $(SLC_DIR)

# Socket-level wrapper (MQC / post-quantum)
mqc:
	$(MAKE) -C $(MQC_DIR)

# Socket-level wrapper (QUIC-inspired / MQCP)
quic:
	$(MAKE) -C $(QUIC_DIR)

# MTC keymaster server (mtc_server) — depends on slc + mqc libraries
mtc: slc mqc
	$(MAKE) -C $(MTC_DIR)

# MTC keymaster client tools (show-tpm, bootstrap_ca, bootstrap_leaf,
# admin_recosign, issue_leaf_nonce) — depends on mqc + shared helpers
# in $(MTC_DIR)
tools: mqc mtc
	$(MAKE) -C $(TOOLS_DIR)

# Install postWolf library (autotools) + ldconfig
install-lib:
	$(MAKE) -f Makefile install
	ldconfig

# Install tools to /usr/local/bin + refresh ldconfig.
# mtc-ca.service and the mtc_server binary are each updated only if their
# repo copy differs from the installed one (cmp -s).  If anything changed
# AND the service is currently active, restart it once at the end so the
# new unit (daemon-reload'd) and the new binary land together.
install: all
	ldconfig
	@_RESTART=0; \
	if cmp -s mtc-keymaster/read-config/myconf.aug \
	         $(DESTDIR)/usr/local/share/augeas/lenses/myconf.aug 2>/dev/null; then \
		echo "[install] myconf.aug unchanged"; \
	else \
		echo "[install] installing fresh myconf.aug"; \
		install -d $(DESTDIR)/usr/local/share/augeas/lenses; \
		install -m 644 mtc-keymaster/read-config/myconf.aug \
			$(DESTDIR)/usr/local/share/augeas/lenses/myconf.aug; \
		_RESTART=1; \
	fi; \
	if cmp -s mtc-keymaster/server2/c/mtc-ca.service \
	         $(DESTDIR)/etc/systemd/system/mtc-ca.service 2>/dev/null; then \
		echo "[install] mtc-ca.service unchanged"; \
	else \
		echo "[install] installing fresh mtc-ca.service"; \
		install -d $(DESTDIR)/etc/systemd/system; \
		install -m 644 mtc-keymaster/server2/c/mtc-ca.service \
			$(DESTDIR)/etc/systemd/system/mtc-ca.service; \
		[ -z "$(DESTDIR)" ] && systemctl daemon-reload; \
		_RESTART=1; \
	fi; \
	if cmp -s mtc-keymaster/server2/c/mtc_server \
	         $(DESTDIR)/usr/local/bin/mtc_server 2>/dev/null; then \
		echo "[install] mtc_server unchanged"; \
	else \
		echo "[install] installing fresh mtc_server"; \
		install -d $(DESTDIR)/usr/local/bin; \
		install -m 755 mtc-keymaster/server2/c/mtc_server \
			$(DESTDIR)/usr/local/bin/mtc_server; \
		_RESTART=1; \
	fi; \
	if [ "$$_RESTART" = "1" ] && [ -z "$(DESTDIR)" ] && \
	   systemctl is-active --quiet mtc-ca.service 2>/dev/null; then \
		echo "[install] restarting mtc-ca.service"; \
		systemctl restart mtc-ca.service; \
	fi
	$(MAKE) -C $(TOOLS_DIR) install
	install -d $(DESTDIR)/usr/local/sbin
	install -m 755 mtc-keymaster/tools/sh/setup-recert-crond.sh \
		$(DESTDIR)/usr/local/sbin/setup-recert-crond.sh
	install -m 755 mtc-keymaster/tools/sh/register-ca.sh \
		$(DESTDIR)/usr/local/bin/register-ca.sh
	install -m 755 mtc-keymaster/tools/sh/register-leaf.sh \
		$(DESTDIR)/usr/local/bin/register-leaf.sh

clean:
	$(MAKE) -C $(SLC_DIR) clean
	$(MAKE) -C $(MQC_DIR) clean
	$(MAKE) -C $(QUIC_DIR) clean
	$(MAKE) -C $(MTC_DIR) clean
	$(MAKE) -C $(TOOLS_DIR) clean
